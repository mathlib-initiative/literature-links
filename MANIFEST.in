# What the sdist carries beyond what setuptools adds on its own (the package,
# README.md, LICENSE, pyproject.toml and tests/test*.py): everything the test
# suite reads, so an unpacked sdist runs `python -m pytest` and
# `python -m unittest discover -s tests` green, with or without the package
# installed.  None of it is inside the package, so the wheel is unchanged: the
# package and its packaged schema only.
include CHANGELOG.md SWITCHOVER.md MANIFEST.in
graft docs
graft examples
graft schema
graft tests
# README.md cites the workflow, and a test checks that every path it cites exists.
graft .github
global-exclude __pycache__ *.py[cod] .DS_Store

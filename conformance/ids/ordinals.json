[
 {
  "name": "ordinals count over every file, in path order then line order",
  "files": [
   {
    "path": "Vec/B.lean",
    "lean": "example : True := trivial\nexample : True := trivial\n"
   },
   {
    "path": "Vec/A.lean",
    "lean": "example : True := trivial\n/- `example:declared` -/\nexample : True := trivial\n"
   },
   {
    "path": "Vec/A/Sub.lean",
    "lean": "example : True := trivial\n"
   }
  ],
  "expected": [
   {
    "file": "Vec/A.lean",
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   },
   {
    "file": "Vec/A.lean",
    "line": 3,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:declared",
    "declared_id": "example:declared"
   },
   {
    "file": "Vec/A/Sub.lean",
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~2"
   },
   {
    "file": "Vec/B.lean",
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~3"
   },
   {
    "file": "Vec/B.lean",
    "line": 2,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~4"
   }
  ],
  "note": "Vec/A.lean sorts before Vec/A/Sub.lean because '.' (U+002E) < '/' (U+002F)"
 },
 {
  "name": "paths compare by UTF-16 code units: U+FF5E sorts before U+1D400",
  "files": [
   {
    "path": "Vec/𝐀.lean",
    "lean": "example : True := trivial\n"
   },
   {
    "path": "Vec/～.lean",
    "lean": "example : True := trivial\n"
   }
  ],
  "expected": [
   {
    "file": "Vec/𝐀.lean",
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   },
   {
    "file": "Vec/～.lean",
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~2"
   }
  ],
  "note": "by code point U+FF5E > U+1D400, by UTF-16 code units 0xFF5E > 0xD835 so U+1D400 sorts first; the vector pins the UTF-16 order"
 },
 {
  "name": "ordinals are per keyword",
  "files": [
   {
    "path": "Vec/C.lean",
    "lean": "instance : Foo := ⟨1⟩\ninstance : Foo := ⟨2⟩\nexample : Foo := ⟨3⟩\nexample : Foo := ⟨4⟩\n"
   }
  ],
  "expected": [
   {
    "file": "Vec/C.lean",
    "line": 1,
    "keyword": "instance",
    "signature": "instance : Foo",
    "hash_form": "instance:Foo",
    "statement_sha256": "a1d80e6f4e974a0b64bb2b5b244cdbacb36f78db97151200a689592906e053e4",
    "id": "instance:a1d80e6f4e97"
   },
   {
    "file": "Vec/C.lean",
    "line": 2,
    "keyword": "instance",
    "signature": "instance : Foo",
    "hash_form": "instance:Foo",
    "statement_sha256": "a1d80e6f4e974a0b64bb2b5b244cdbacb36f78db97151200a689592906e053e4",
    "id": "instance:a1d80e6f4e97~2"
   },
   {
    "file": "Vec/C.lean",
    "line": 3,
    "keyword": "example",
    "signature": "example : Foo",
    "hash_form": "example:Foo",
    "statement_sha256": "6f7d4a69ef85eb732a00ba5492489775c54867c48c283cb076442ae83cd84dd9",
    "id": "example:6f7d4a69ef85"
   },
   {
    "file": "Vec/C.lean",
    "line": 4,
    "keyword": "example",
    "signature": "example : Foo",
    "hash_form": "example:Foo",
    "statement_sha256": "6f7d4a69ef85eb732a00ba5492489775c54867c48c283cb076442ae83cd84dd9",
    "id": "example:6f7d4a69ef85~2"
   }
  ]
 },
 {
  "name": "formatting variants of one statement share an id and take ordinals",
  "lean": "example : True := trivial\nexample : True := trivial\nexample :   True :=\n  trivial\nexample\n  : True := trivial\n",
  "expected": [
   {
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   },
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~2"
   },
   {
    "line": 3,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~3"
   },
   {
    "line": 5,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~4"
   }
  ]
 }
]

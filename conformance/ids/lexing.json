[
 {
  "name": "nested block comment hides a declaration",
  "lean": "/- outer /- inner example : False := sorry -/ still comment example : False := x -/\nexample : True := trivial\n",
  "expected": [
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   }
  ]
 },
 {
  "name": "doc comment with nested block and a stray quote",
  "lean": "/-- a doc with /- nested -/ and \"quote -/\nexample : True := trivial\nexample : False := sorry\n",
  "expected": [
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   },
   {
    "line": 3,
    "keyword": "example",
    "signature": "example : False",
    "hash_form": "example:False",
    "statement_sha256": "8dd6226f42a34bb50a2bb0e9776ddd7967514d29749bb30994c262bc0bfa4d0b",
    "id": "example:8dd6226f42a3"
   }
  ]
 },
 {
  "name": "unterminated block comment swallows the rest",
  "lean": "example : True := trivial\n/- never closed\nexample : False := sorry\n",
  "expected": [
   {
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   }
  ]
 },
 {
  "name": "`/--/` is not a closed comment, `/-- -/` is",
  "lean": "/-- -/\nexample : Foo := ⟨1⟩\n/--/ example : Bar := ⟨2⟩ -/\nexample : Baz := ⟨3⟩\n",
  "expected": [
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : Foo",
    "hash_form": "example:Foo",
    "statement_sha256": "6f7d4a69ef85eb732a00ba5492489775c54867c48c283cb076442ae83cd84dd9",
    "id": "example:6f7d4a69ef85"
   },
   {
    "line": 4,
    "keyword": "example",
    "signature": "example : Baz",
    "hash_form": "example:Baz",
    "statement_sha256": "70fd1f3d6b3940ede36bb494a56a6ff6c487f717b9b9a2055d55e1ce0d1f55f6",
    "id": "example:70fd1f3d6b39"
   }
  ]
 },
 {
  "name": "line comment markers inside strings are text",
  "lean": "def s := \"a -- not a comment\"\nexample : s = \"a -- not a comment\" := rfl\n",
  "expected": [
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : s = \"a -- not a comment\"",
    "hash_form": "example:s=\"a -- not a comment\"",
    "statement_sha256": "076b8517d465e9cf5e6b46ce91a30988d3e55e1690f01d7a270756b8e3ad9146",
    "id": "example:076b8517d465"
   }
  ]
 },
 {
  "name": "keywords inside comments, strings and guillemets are not declarations",
  "lean": "-- example : False := sorry\n/-- example : False := sorry -/\ndef x := \"\nexample : False := sorry\n\"\ndef my_example := 1\ndef «example» := 2\ntheorem Foo.example_thm : True := trivial\nexample : x = x := rfl\n",
  "expected": [
   {
    "line": 9,
    "keyword": "example",
    "signature": "example : x = x",
    "hash_form": "example:x=x",
    "statement_sha256": "a58cb429d3c882fc26b8e3c08531aacedffd9ef9fcbb264e5598fee0e248a269",
    "id": "example:a58cb429d3c8"
   }
  ]
 },
 {
  "name": "string literals are opaque: a `:=` or bracket inside never counts",
  "lean": "example : \"a\\\"b\" = \"x := y\" := rfl\nexample : \"(\" ++ \")\" = \"()\" := rfl\n",
  "expected": [
   {
    "line": 1,
    "keyword": "example",
    "signature": "example : \"a\\\"b\" = \"x := y\"",
    "hash_form": "example:\"a\\\"b\"=\"x := y\"",
    "statement_sha256": "63029208bbc8f367b469b9b9afa206981b7195ca37a1451335926f7ddb43a594",
    "id": "example:63029208bbc8"
   },
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : \"(\" ++ \")\" = \"()\"",
    "hash_form": "example:\"(\"++\")\"=\"()\"",
    "statement_sha256": "8e2a7b21c001d5c2e6f501c2e99e995b7b0ed8c4bd0fd8def83745af0f2a45d2",
    "id": "example:8e2a7b21c001"
   }
  ]
 },

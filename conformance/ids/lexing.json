    "id": "example:df6a4534a266"
   }
  ]
 },
 {
  "name": "a leading byte order mark is ignored",
  "lean": "﻿example : True := trivial\nexample : True := trivial\n",
  "expected": [
   {
    "line": 1,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d"
   },
   {
    "line": 2,
    "keyword": "example",
    "signature": "example : True",
    "hash_form": "example:True",
    "statement_sha256": "15d809f6918d5b255aee11bd83eb3cb155c84e626c00ad158655b146637df19b",
    "id": "example:15d809f6918d~2"

    "id": "example:5ad3e6917f8b"
   }
  ]
 },
 {
  "name": "a prime after a name is not a char literal; image notation `''`",
  "lean": "example (f : α → β) (s : Set α) : f '' s = f '' s := rfl\nexample (f' : ℕ → ℕ) : f' 0 = f' 0 := rfl\nexample (x₁' : ℕ) : x₁' = x₁' := rfl\n",
  "expected": [
   {
    "line": 1,
    "keyword": "example",
    "signature": "example (f : α → β) (s : Set α) : f '' s = f '' s",
    "hash_form": "example(f:α→β)(s:Set α):f '' s=f '' s",
    "statement_sha256": "98b7ed6899b00320868a6d8f531c17b0055d92766e3eb0ebcf424165e4678cd2",
    "id": "example:98b7ed6899b0"
   },
   {
    "line": 2,
    "keyword": "example",

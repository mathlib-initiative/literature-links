{
  "description": "Language-neutral examples for the current unversioned single-annotation contract. This file is a test corpus, not an annotation carrier.",
  "cases": [
    {
      "id": "whole-resource",
      "description": "Only source and target are required. Omission of location selects the whole informal resource.",
      "annotation": {
        "source": {
          "type": "generic",
          "uri": "../informal/notes"
        },
        "target": "../formal/results.html#result"
      },
      "schema_valid": true,
      "valid": true,
      "problem_codes": []
    },
    {

    {
      "id": "opaque-generic-and-extensions",
      "description": "Unknown selectors, nested keys, schema-looking data, and exact integers remain application-owned JSON.",
      "annotation": {
        "source": {
          "type": "generic",
          "uri": "../informal/notes",
          "extensions": {
            "example:source": {
              "edition": "draft"
            }
          }
        },
        "target": "../formal/results.html#result",
        "location": {
          "future-selector": {
            "path": [
              null,
              true,
              1.25
            ]
          },
          "$ref": "https://example.org/not-fetched"
        },
        "extensions": {
          "example:tool": {
            "$schema": "urn:example:unknown",
            "": [
              "α",
              null
            ],
            "large_integer": 9007199254740993
          }
        }
      },
      "schema_valid": true,
      "valid": true,
      "problem_codes": []
    },

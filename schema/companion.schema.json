{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mathlib-initiative/literature-links/main/schema/companion.schema.json",
  "title": "Literature Links annotation",
  "description": "One Literature Links annotation. The specification (docs/companion.md) defines every field.",
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/$defs/reference"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": [
        "string",
        "object"
      ],
      "allOf": [
        {
          "if": {
            "type": "string"
          },
          "then": {
            "$ref": "#/$defs/reference"
          }
        },
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/endpoint"
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "status": {
      "type": [
        "string",
        "object"
      ],
      "allOf": [
        {
          "if": {
            "type": "string"
          },
          "then": {
            "$ref": "#/$defs/text"
          }
        },
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/status"
          }
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/text"
    },
    "label": {
      "$ref": "#/$defs/text"
    },
    "note": {
      "$ref": "#/$defs/text"
    }
  },
  "additionalProperties": false,
  "required": [
    "source"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "const": "pdf"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "location": {
            "if": {
              "required": [
                "profile"
              ]
            },
            "else": {
              "$ref": "#/$defs/pdf_location"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "const": "latex"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "location": {
            "if": {
              "required": [
                "profile"
              ]
            },
            "else": {
              "$ref": "#/$defs/latex_location"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "const": "html"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "location": {
            "if": {
              "required": [
                "profile"
              ]
            },
            "else": {
              "$ref": "#/$defs/html_location"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200f\\u2028-\\u202f\\u205f\\u2066-\\u2069\\u3000\\ufeff\\ufffe\\uffff%]|%[0-9A-Fa-f]{2})+(?![\\s\\S])"
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200f\\u2028-\\u202f\\u205f\\u2066-\\u2069\\u3000\\ufeff\\ufffe\\uffff]+(?![\\s\\S])": true
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "pdf",
            "latex",
            "html",
            "generic"
          ]
        },
        "uri": {
          "$ref": "#/$defs/reference"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "uri"
      ]
    },
    "pdf_location": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "rect": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "quote": {
          "$ref": "#/$defs/quote"
        }
      },
      "additionalProperties": false,
      "required": [
        "page"
      ],
      "not": {
        "required": [
          "rect",
          "quote"
        ]
      }
    },
    "latex_location": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "lines"
          ]
        }
      ]
    },
    "html_location": {
      "type": "object",
      "properties": {
        "fragment": {
          "type": "string",
          "pattern": "^[^#\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000][^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*(?![\\s\\S])"
        },
        "css": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "$ref": "#/$defs/quote"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "fragment"
          ]
        },
        {
          "required": [
            "css"
          ]
        },
        {
          "required": [
            "quote"
          ]
        }
      ]
    },
    "quote": {
      "type": "object",
      "properties": {
        "exact": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "exact"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "uri": {
          "$ref": "#/$defs/reference"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri"
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/text"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "authors": {
      "type": [
        "string",
        "array"
      ],
      "minLength": 1,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "identifiers": {
      "type": "object",
      "patternProperties": {
        "^[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200f\\u2028-\\u202f\\u205f\\u2066-\\u2069\\u3000\\ufeff\\ufffe\\uffff]+(?![\\s\\S])": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?(?![\\s\\S])"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "website_pin": {
      "type": "object",
      "properties": {
        "type": {
          "const": "website"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/reference"
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/text"
        },
        "retrieved": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identifiers": {
          "$ref": "#/$defs/identifiers"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "book_pin": {
      "type": "object",
      "properties": {
        "type": {
          "const": "book"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "author": {
          "$ref": "#/$defs/authors"
        },
        "publisher": {
          "$ref": "#/$defs/text"
        },
        "edition": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/text"
        },
        "isbn": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/reference"
        },
        "retrieved": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identifiers": {
          "$ref": "#/$defs/identifiers"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "paper_pin": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paper"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "author": {
          "$ref": "#/$defs/authors"
        },
        "venue": {
          "$ref": "#/$defs/text"
        },
        "volume": {
          "$ref": "#/$defs/text"
        },
        "number": {
          "$ref": "#/$defs/text"
        },
        "pages": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/text"
        },
        "doi": {
          "$ref": "#/$defs/text"
        },
        "arxiv": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/reference"
        },
        "retrieved": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identifiers": {
          "$ref": "#/$defs/identifiers"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "repository_pin": {
      "type": "object",
      "properties": {
        "type": {
          "const": "repository"
        },
        "url": {
          "$ref": "#/$defs/reference"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "path": {
          "$ref": "#/$defs/text"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "module": {
          "$ref": "#/$defs/text"
        },
        "declaration": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identifiers": {
          "$ref": "#/$defs/identifiers"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "website",
            "book",
            "paper",
            "repository",
            "generic"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "website"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/website_pin"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "book"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/book_pin"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "paper"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/paper_pin"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "repository"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/repository_pin"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "generic"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "url": {
                "$ref": "#/$defs/reference"
              }
            }
          }
        }
      ]
    }
  }
}

{
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/$defs/reference",
      "description": "A tooling hint. It never replaces this schema."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "description": "Application data for this annotation."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "A label. It need not be unique."
    },
    "target": {
      "$ref": "#/$defs/reference",
      "description": "A reference to the formal destination. This name does not mean the W3C annotation target."
    },
    "location": {
      "type": "object",
      "description": "Part of the source. Its form depends on source.type. Absent means the whole source."
    }
  },
  "additionalProperties": false,
  "required": [
    "source",
    "target"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mathlib-initiative/formal-companion-annotations/main/schema/companion.schema.json",
  "title": "Formal companion annotation",
  "description": "One link from an informal source, or a location in it, to a formal target. Validation also checks that a PDF rect has positive size and fits its page, and that LaTeX lines are in order.",
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "const": "pdf"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "$ref": "#/$defs/pdf_location"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "const": "latex"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "$ref": "#/$defs/latex_location"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "const": "html"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "$ref": "#/$defs/html_location"
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+(?![\\s\\S])",
      "description": "A URI or IRI reference without White_Space or controls. A relative one resolves against the file that holds the annotation."
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[^\\u0000-\\u0020\\u007f-\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+(?![\\s\\S])": true
      },
      "additionalProperties": false,
      "description": "Application data under keys without White_Space or controls. Namespaced keys are recommended."
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "pdf",
            "latex",
            "html",
            "generic"
          ],
          "description": "The kind of source. It decides the form of location."
        },
        "uri": {
          "$ref": "#/$defs/reference",
          "description": "A reference to the informal resource."
        },
        "extensions": {
          "$ref": "#/$defs/extensions",
          "description": "Application data for the source."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "uri"
      ],
      "description": "The informal resource."
    },
    "pdf_location": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "Physical page number from 1, ignoring page labels."
        },
        "rect": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "[x, y, width, height] as fractions of the displayed CropBox after the page's rotation, from the top-left. It has positive size and fits the page (checked outside this schema)."
        }
      },
      "additionalProperties": false,
      "required": [
        "page"
      ],
      "description": "A page, optionally with a rectangle."
    },
    "latex_location": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "A literal label in the file. The validator does not expand macros."
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Inclusive line range [start, end] from 1, with end >= start (checked outside this schema)."
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "lines"
          ]
        }
      ],
      "description": "A label or an inclusive line range."
    },
    "html_location": {
      "type": "object",
      "properties": {
        "fragment": {
          "allOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "not": {
                "pattern": "^#"
              }
            }
          ],
          "description": "A decoded element ID without a leading #."
        },
        "css": {
          "type": "string",
          "minLength": 1,
          "description": "A CSS selector. It is not parsed."
        },
        "quote": {
          "$ref": "#/$defs/quote",
          "description": "A quotation in the HTML text layer that the specification defines."
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "fragment"
          ]
        },
        {
          "required": [
            "css"
          ]
        },
        {
          "required": [
            "quote"
          ]
        }
      ],
      "description": "An element ID, a CSS selector or a quotation."
    },
    "quote": {
      "type": "object",
      "properties": {
        "exact": {
          "type": "string",
          "minLength": 1,
          "description": "The selected text."
        },
        "prefix": {
          "type": "string",
          "description": "Text just before the selection."
        },
        "suffix": {
          "type": "string",
          "description": "Text just after the selection."
        }
      },
      "additionalProperties": false,
      "required": [
        "exact"
      ],
      "description": "A text selection with optional context."
    }
  }
}
